  "cards": [
    {
      "dot": "rose",
      "title": "Authorization",
      "items": [
        "Appointment requires APPOINTMENT_CREATE. The Feign interceptor forwards the caller’s Authorization header.",
        "The patient and doctor lookups require PATIENT_READ and DOCTOR_READ. RECEPTIONIST has all three authorities."
      ]
    },
    {
      "dot": "emerald",
      "title": "Booking checks",
      "items": [
        "Appointment requires an active patient and doctor. It validates the schedule before saving.",
        "The overlap query checks the doctor and date using the requested time interval.",
        "The successful response includes the appointment and a Location header."
      ]
    }
  ]
