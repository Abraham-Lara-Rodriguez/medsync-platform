  "cards": [
    {
      "dot": "cyan",
      "title": "Configuration and discovery",
      "items": [
        "Discovery and the business services also load settings from Config Server.",
        "The business services register with Eureka and use the shared authenticated registry URL.",
        "The gateway resolves the four service destinations and forwards requests. Endpoint authorization runs in the business services."
      ]
    },
    {
      "dot": "emerald",
      "title": "Service dependencies",
      "items": [
        "Each business service uses its own PostgreSQL container.",
        "Appointment checks Patient and Doctor through OpenFeign before saving a new booking. See the appointment sequence."
      ]
    },
    {
      "dot": "violet",
      "title": "Telemetry",
      "items": [
        "Compose configures all seven Java applications to send OTLP HTTP to Alloy.",
        "Alloy forwards telemetry to the configured upstream endpoint."
      ]
    }
  ]
