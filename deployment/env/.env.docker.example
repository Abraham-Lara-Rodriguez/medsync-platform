# MedSync · Docker Compose
# Copy this template to .env.docker and fill in the required secrets.
# Applications send OTLP data to grafana-alloy:4318. The endpoint below is the destination Alloy exports to.

# Shared credentials for Config Server and Eureka. Set a local password.
SERVER_USER=medsync
SERVER_PASSWORD=

# Infrastructure and gateway.
CONFIG_SERVER_HOSTNAME=config-service
CONFIG_SERVER_PORT=8888
DISCOVERY_SERVER_HOSTNAME=discovery-service
DISCOVERY_SERVER_PORT=8761
GATEWAY_SERVER_PORT=8222
GATEWAY_SERVER_PROFILES=prod

# Authentication.
AUTH_SERVER_DB_URL=jdbc:postgresql://auth-service-postgres:5432/medsync_auth
AUTH_SERVER_DB_NAME=medsync_auth
AUTH_SERVER_DB_USERNAME=medsync
AUTH_SERVER_DB_PASSWORD=
AUTH_SERVER_PORT=8001
AUTH_SERVER_PROFILES=prod

# JWT. Use a random Base64-encoded key that decodes to at least 32 bytes. Token lifetimes are in milliseconds.
AUTH_SERVER_SECRET_KEY=
AUTH_SERVER_ACCESS_TOKEN_EXPIRATION=3600000
AUTH_SERVER_REFRESH_TOKEN_EXPIRATION=86400000
AUTH_SERVER_PASSWORD_STRENGTH=12
AUTH_SERVER_CLIENT_ORIGIN=http://localhost:3000

# Initial administrator. Set a password before enabling admin bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ENABLED=false

# Patients.
PATIENT_SERVER_DB_URL=jdbc:postgresql://patient-service-postgres:5432/medsync_patient
PATIENT_SERVER_DB_NAME=medsync_patient
PATIENT_SERVER_DB_USERNAME=medsync
PATIENT_SERVER_DB_PASSWORD=
PATIENT_SERVER_PORT=8002
PATIENT_SERVER_PROFILES=prod

# Encryption and hashing keys. Set a different random secret for each field and retain it for as long as you use the same data.
PATIENT_ENCRYPTION_KEY=
PATIENT_HASH_KEY=
DOCTOR_ENCRYPTION_KEY=
DOCTOR_HASH_KEY=

# Doctors.
DOCTOR_SERVER_DB_URL=jdbc:postgresql://doctor-service-postgres:5432/medsync_doctor
DOCTOR_SERVER_DB_NAME=medsync_doctor
DOCTOR_SERVER_DB_USERNAME=medsync
DOCTOR_SERVER_DB_PASSWORD=
DOCTOR_SERVER_PROFILES=prod
DOCTOR_SERVER_PORT=8003

# Appointments.
APPOINTMENT_SERVER_DB_URL=jdbc:postgresql://appointment-service-postgres:5432/medsync_appointment
APPOINTMENT_SERVER_DB_NAME=medsync_appointment
APPOINTMENT_SERVER_DB_USERNAME=medsync
APPOINTMENT_SERVER_DB_PASSWORD=
APPOINTMENT_SERVER_PROFILES=prod
APPOINTMENT_SERVER_PORT=8004

# Telemetry. If you export to Grafana Cloud, configure your account endpoint and authorization.
OTEL_AGENT_VERSION=2.31.0
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
GRAFANA_CLOUD_AUTHORIZATION=
