#----------------#
# Config Service #
#----------------#
CONFIG_SERVER_HOSTNAME=config-service
CONFIG_SERVER_PORT=8888

#-------------------#
# Discovery Service #
#-------------------#
DISCOVERY_SERVER_HOSTNAME=discovery-service
DISCOVERY_SERVER_PORT=8761

#--------------#
# API GATEWAY  #
#--------------#
GATEWAY_SERVER_PORT=8222
# Environment of spring profiles
GATEWAY_SERVER_PROFILES=prod
# GATEWAY_SERVER_PROFILES=dev

#--------------#
# Auth Service #
#--------------#
# Environment of auth database
AUTH_SERVER_DB_URL=jdbc:postgresql://auth-service-postgres:5432/auth-service
AUTH_SERVER_DB_NAME=auth-service
AUTH_SERVER_DB_USERNAME=<DB_USERNAME>
AUTH_SERVER_DB_PASSWORD=<DB_PASSWORD>
# Environment of auth server
AUTH_SERVER_PORT=8001
# Environment of spring profiles
# AUTH_SERVER_PROFILES=dev
AUTH_SERVER_PROFILES=prod
# Environment of spring security
AUTH_SERVER_SECRET_KEY=<AUTH_SECRET_KEY>
AUTH_SERVER_ACCESS_TOKEN_EXPIRATION=3600000
AUTH_SERVER_REFRESH_TOKEN_EXPIRATION=86400000
AUTH_SERVER_PASSWORD_STRENGTH=12
# Environment of client origin
AUTH_SERVER_CLIENT_ORIGIN=http://localhost:3000
# Environment of bootstrap admin
BOOTSTRAP_ADMIN_EMAIL=<ADMIN_EMAIL>
BOOTSTRAP_ADMIN_PASSWORD=<ADMIN_PASSWORD>
BOOTSTRAP_ADMIN_ENABLED=false

#-----------------#
# Patient Service #
#-----------------#
# Environment of patient database
PATIENT_SERVER_DB_URL=jdbc:postgresql://patient-service-postgres:5432/patient-service
PATIENT_SERVER_DB_NAME=patient-service
PATIENT_SERVER_DB_USERNAME=<DB_USERNAME>
PATIENT_SERVER_DB_PASSWORD=<DB_PASSWORD>
# Environment of patient server
PATIENT_SERVER_PORT=8002
# Environment of spring profiles
PATIENT_SERVER_PROFILES=prod
# PATIENT_SERVER_PROFILES=dev
# Environment of secret keys
PATIENT_ENCRYPTION_KEY=<PATIENT_ENCRYPTION_KEY>
PATIENT_HASH_KEY=<PATIENT_HASH_KEY>
DOCTOR_ENCRYPTION_KEY=<DOCTOR_ENCRYPTION_KEY>
DOCTOR_HASH_KEY=<DOCTOR_HASH_KEY>

#----------------#
# doctor-service #
#----------------#
# Environment of doctor database
DOCTOR_SERVER_DB_URL=jdbc:postgresql://doctor-service-postgres:5432/doctor-service
DOCTOR_SERVER_DB_NAME=doctor-service
DOCTOR_SERVER_DB_USERNAME=<DB_USERNAME>
DOCTOR_SERVER_DB_PASSWORD=<DB_PASSWORD>
# Environment of spring profiles
# DOCTOR_SERVER_PROFILES=dev
DOCTOR_SERVER_PROFILES=prod
# Environment of doctor server
DOCTOR_SERVER_PORT=8003

