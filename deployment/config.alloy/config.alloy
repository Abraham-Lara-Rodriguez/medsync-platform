
otelcol.receiver.otlp "medsync" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.medsync.input]
  }
}

otelcol.processor.batch "medsync" {
  output {
    traces = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("OTEL_EXPORTER_OTLP_ENDPOINT")
    headers  = {
      "Authorization" = sys.env("GRAFANA_CLOUD_AUTHORIZATION"),
    }
  }
}
